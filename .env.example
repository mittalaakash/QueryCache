# Ollama embedding model for ingestion + query embedding.
# Pull it first: `ollama pull nomic-embed-text`
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local pgvector Postgres (see docker-compose.yml) — isolated from any
# other project's database. Do not point this at :5432.
DATABASE_URL=postgresql://raguser:ragpass@localhost:5433/ragdb

# Optional: Langfuse tracing (self-hostable). Leave unset to skip it.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
